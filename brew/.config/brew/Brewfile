# ─── Linux uniquement ──────────────────────────────────
if OS.linux?
  # Presse-papier système (X11) pour nvim (clipboard=unnamedplus) et le shell ;
  # sous Wayland, ce serait wl-clipboard
  brew "xclip"
  # Requis par Mason (outils de nvim), absent d'une Ubuntu minimale ; macOS le fournit déjà
  brew "unzip"
end
