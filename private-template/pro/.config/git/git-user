# Identité git par défaut de cette machine (contexte pro).
# Inclus par ~/.config/git/config ; la signature est ici car elle va avec l'identité.
# Le proxy n'a pas besoin d'être répété ici : git lit https_proxy (cf. `proxy on`).
[user]
	name = Prénom Nom
	email = prenom.nom@entreprise.example
	# signingkey = <ID de ta clé GPG pro>
[commit]
	gpgsign = true
[tag]
	gpgsign = true
